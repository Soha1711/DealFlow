# -----------------------------------------------------------------------------
# DealFlow360 environment configuration
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env
# -----------------------------------------------------------------------------

# PostgreSQL connection used by Prisma and the application server.
# Matches the local `docker compose up -d postgres` defaults.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dealflow360"

# Auth.js / NextAuth secret. Generate a strong random value:
#   Windows PowerShell:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   macOS / Linux:       openssl rand -base64 32
AUTH_SECRET="generate-a-random-64-character-secret-and-keep-it-private"

# Required by Auth.js when running behind a non-Vercel host (local dev).
AUTH_TRUST_HOST=true

# Public origin of the application.
AUTH_URL="http://localhost:3000"

# Optional AI ranking layer for Phase 4 recommendations.
# Leave unset to run the deterministic engine only (fully supported).
# The AI may only re-rank/explain server-scored candidates; it never mutates
# business data and all requests happen server-side.
# AI_API_KEY="sk-..."
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"