generator client {
  provider = "prisma-client-js"
  output   = "../../frontend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE
  OPERATIONS
  CUSTOMER
}

enum CustomerTier {
  STANDARD
  SILVER
  GOLD
  PLATINUM
}

enum DiscountApprovalLevel {
  NONE
  MANAGER
  MANAGER_AND_FINANCE
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  salesTeamId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// CRM fundamentals
// ---------------------------------------------------------------------------

model Customer {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  tier      CustomerTier @default(STANDARD)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("customers")
}

model Product {
  id                 String           @id @default(cuid())
  name               String
  sku                String           @unique
  category           String
  price              Decimal          @db.Decimal(12, 2)
  cost               Decimal          @db.Decimal(12, 2)
  maxDiscountPercent Int              @default(20)
  isRecurring        Boolean          @default(false)
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  inventory          Inventory[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([category])
  @@index([isRecurring])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Discount governance configuration
// ---------------------------------------------------------------------------
// These records are configuration only. The actual discount approval engine
// is implemented in a later phase.

model DiscountTier {
  id            String                 @id @default(cuid())
  name          String                 @unique
  minDiscount   Int
  maxDiscount   Int
  approvalLevel DiscountApprovalLevel
  createdAt     DateTime               @default(now())

  @@index([approvalLevel])
  @@map("discount_tiers")
}

// ---------------------------------------------------------------------------
// Fulfillment fundamentals
// ---------------------------------------------------------------------------

model Warehouse {
  id        String      @id @default(cuid())
  name      String      @unique
  location  String
  inventory Inventory[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("warehouses")
}

model Inventory {
  id               String    @id @default(cuid())
  warehouseId      String
  productId        String
  quantity         Int       @default(0)
  reservedQuantity Int       @default(0)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt        DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("inventory")
}

// ---------------------------------------------------------------------------
// Subscription fundamentals
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id              String          @id @default(cuid())
  name            String          @unique
  price           Decimal         @db.Decimal(12, 2)
  billingInterval BillingInterval
  products        Product[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("subscription_plans")
}