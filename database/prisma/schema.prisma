generator client {
  provider = "prisma-client-js"
  output   = "../../frontend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE
  OPERATIONS
  CUSTOMER
}

enum CustomerTier {
  STANDARD
  SILVER
  GOLD
  PLATINUM
}

enum DiscountApprovalLevel {
  NONE
  MANAGER
  MANAGER_AND_FINANCE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalLevel {
  MANAGER
  FINANCE
}

enum DiscountRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  DISCOUNT_CHECK
  PENDING_MANAGER
  PENDING_FINANCE
  APPROVED
  REJECTED
  UNDER_NEGOTIATION
  CONFIRMED
  FULFILLING
  COMPLETED
}

enum FulfillmentStatus {
  PENDING_ALLOCATION
  ALLOCATED
  PARTIALLY_ALLOCATED
  PARTIALLY_FULFILLED
  FULFILLED
  COMPLETED
  CANCELLED
}

enum FulfillmentLineStatus {
  REQUESTED
  ALLOCATED
  PARTIALLY_FULFILLED
  FULFILLED
  BACKORDERED
  CANCELLED
}

enum FulfillmentAllocationStatus {
  ALLOCATED
  FULFILLED
  RELEASED
}

enum InventoryReservationStatus {
  ACTIVE
  FULFILLED
  RELEASED
}

enum InvoiceType {
  ONE_TIME
  RECURRING
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  OVERDUE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum BillingScheduleStatus {
  SCHEDULED
  DUE
  PAID
  FAILED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role
  salesTeamId  String?
  quotations   Quotation[]
  approvals    Approval[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([role])
  @@map("users")
}

model Product {
  id                 String            @id @default(cuid())
  name               String
  sku                String            @unique
  category           String
  price              Decimal           @db.Decimal(12, 2)
  cost               Decimal           @db.Decimal(12, 2)
  maxDiscountPercent Int               @default(20)
  isRecurring        Boolean           @default(false)
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  inventory          Inventory[]
  quotationLines     QuotationLine[]
  fulfillmentLines   FulfillmentLine[]
  invoiceLines       InvoiceLine[]
  subscriptions      Subscription[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([category])
  @@index([isRecurring])
  @@map("products")
}

model SubscriptionPlan {
  id              String          @id @default(cuid())
  name            String          @unique
  price           Decimal         @db.Decimal(12, 2)
  billingInterval BillingInterval
  products        Product[]
  subscriptions   Subscription[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("subscription_plans")
}

model Warehouse {
  id        String      @id @default(cuid())
  name      String      @unique
  location  String
  inventory Inventory[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("warehouses")
}

model Inventory {
  id               String                  @id @default(cuid())
  warehouseId      String
  productId        String
  quantity         Int                     @default(0)
  reservedQuantity Int                     @default(0)
  warehouse        Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product          Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  allocations      FulfillmentAllocation[]
  reservations     InventoryReservation[]
  updatedAt        DateTime                @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("inventory")
}

model Quotation {
  id                     String                @id @default(cuid())
  quotationNumber        String                @unique
  customerId             String
  salesRepId             String
  status                 QuotationStatus       @default(DRAFT)
  subtotal               Decimal               @default(0) @db.Decimal(12, 2)
  discountTotal          Decimal               @default(0) @db.Decimal(12, 2)
  total                  Decimal               @default(0) @db.Decimal(12, 2)
  margin                 Decimal               @default(0) @db.Decimal(12, 2)
  validUntil             DateTime?
  // Deterministic discount-governance snapshot, computed at submit time.
  riskScore              Int?
  riskLevel              DiscountRiskLevel?
  requiredApprovalLevel  DiscountApprovalLevel?
  customer               Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesRep               User                  @relation(fields: [salesRepId], references: [id], onDelete: Restrict)
  lines                  QuotationLine[]
  approvals              Approval[]
  fulfillments           Fulfillment[]
  invoices               Invoice[]
  subscriptions          Subscription[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([customerId])
  @@index([salesRepId])
  @@index([status])
  @@index([riskLevel])
  @@index([createdAt])
  @@map("quotations")
}

model Fulfillment {
  id          String            @id @default(cuid())
  quotationId String
  status      FulfillmentStatus @default(PENDING_ALLOCATION)
  quotation   Quotation         @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  lines       FulfillmentLine[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([quotationId])
  @@index([status])
  @@index([createdAt])
  @@map("fulfillments")
}

model FulfillmentLine {
  id                 String                    @id @default(cuid())
  fulfillmentId      String
  productId          String
  requestedQuantity  Int
  allocatedQuantity  Int                       @default(0)
  fulfilledQuantity  Int                       @default(0)
  backorderQuantity  Int                       @default(0)
  status             FulfillmentLineStatus     @default(REQUESTED)
  fulfillment        Fulfillment               @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  product            Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  allocations        FulfillmentAllocation[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([fulfillmentId])
  @@index([productId])
  @@index([status])
  @@map("fulfillment_lines")
}

model FulfillmentAllocation {
  id                String                      @id @default(cuid())
  fulfillmentLineId String
  inventoryId       String
  quantity          Int
  status            FulfillmentAllocationStatus @default(ALLOCATED)
  fulfillmentLine   FulfillmentLine             @relation(fields: [fulfillmentLineId], references: [id], onDelete: Cascade)
  inventory         Inventory                   @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  reservations      InventoryReservation[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([fulfillmentLineId])
  @@index([inventoryId])
  @@map("fulfillment_allocations")
}

model InventoryReservation {
  id           String                     @id @default(cuid())
  inventoryId  String
  allocationId String?
  quantity     Int
  status       InventoryReservationStatus @default(ACTIVE)
  inventory    Inventory                  @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  allocation   FulfillmentAllocation?     @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  createdAt    DateTime                   @default(now())
  releasedAt   DateTime?

  @@index([inventoryId])
  @@index([allocationId])
  @@index([status])
  @@map("inventory_reservations")
}

// ---------------------------------------------------------------------------
// CRM fundamentals
// ---------------------------------------------------------------------------

model Customer {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  tier          CustomerTier   @default(STANDARD)
  quotations    Quotation[]
  invoices      Invoice[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("customers")
}

// ---------------------------------------------------------------------------
// Discount governance configuration
// ---------------------------------------------------------------------------
// These records are configuration only. The actual discount approval engine
// is implemented in a later phase.

// ---------------------------------------------------------------------------
// Billing & subscriptions (Phase 6)
// ---------------------------------------------------------------------------

model Subscription {
  id                 String             @id @default(cuid())
  customerId         String
  quotationId        String
  quotationLineId    String             @unique
  productId          String
  subscriptionPlanId String?
  status             SubscriptionStatus @default(ACTIVE)
  billingInterval    BillingInterval
  recurringAmount    Decimal            @db.Decimal(12, 2)
  startDate          DateTime
  nextBillingDate    DateTime
  cancelledAt        DateTime?
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation          Quotation          @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  quotationLine      QuotationLine      @relation(fields: [quotationLineId], references: [id], onDelete: Restrict)
  product            Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  subscriptionPlan   SubscriptionPlan?  @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  schedules          BillingSchedule[]
  invoices           Invoice[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
  @@map("subscriptions")
}

model BillingSchedule {
  id             String                @id @default(cuid())
  subscriptionId String
  periodStart    DateTime
  periodEnd      DateTime
  dueDate        DateTime
  amount         Decimal               @default(0) @db.Decimal(12, 2)
  status         BillingScheduleStatus @default(SCHEDULED)
  invoiceId      String?               @unique
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice        Invoice?              @relation("ScheduleInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([subscriptionId, periodStart])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
  @@map("billing_schedules")
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  type           InvoiceType   @default(ONE_TIME)
  status         InvoiceStatus @default(DRAFT)
  customerId     String
  quotationId    String?
  subscriptionId String?
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  issueDate      DateTime?
  dueDate        DateTime?
  // Idempotency anchor: `ot:{quotationId}` for one-time invoices and
  // `schedule:{scheduleId}` for a subscription period's invoice, so duplicate
  // billing is impossible at the database level.
  billingKey     String?       @unique
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation      Quotation?    @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  schedule       BillingSchedule? @relation("ScheduleInvoice")
  lines          InvoiceLine[]
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([customerId])
  @@index([quotationId])
  @@index([subscriptionId])
  @@index([status])
  @@index([type])
  @@map("invoices")
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  productId      String?
  description    String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(12, 2)
  isRecurring    Boolean  @default(false)
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(SUCCEEDED)
  method          String?
  reference       String?
  // Webhook-ready: external providers send an event id; duplicate events are
  // rejected by the unique constraint instead of double-crediting.
  externalEventId String?       @unique
  // Optional caller-supplied idempotency key for internal recording.
  idempotencyKey  String?       @unique
  paidAt          DateTime?
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

model DiscountTier {
  id            String                 @id @default(cuid())
  name          String                 @unique
  minDiscount   Int
  maxDiscount   Int
  approvalLevel DiscountApprovalLevel
  createdAt     DateTime               @default(now())

  @@index([approvalLevel])
  @@map("discount_tiers")
}

model Approval {
  id          String              @id @default(cuid())
  quotationId String
  level       ApprovalLevel
  approverId  String?
  status      ApprovalStatus      @default(PENDING)
  reason      String?
  actedAt     DateTime?
  quotation   Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approver    User?               @relation(fields: [approverId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([quotationId])
  @@index([status])
  @@index([approverId])
  @@map("approvals")
}

model QuotationLine {
  id              String        @id @default(cuid())
  quotationId     String
  productId       String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  discountPercent Int           @default(0)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal       @default(0) @db.Decimal(12, 2)
  margin          Decimal       @default(0) @db.Decimal(12, 2)
  isRecurring     Boolean       @default(false)
  quotation       Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  subscription    Subscription?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_lines")
}